FROM node:20-slim

WORKDIR /app

# OpenSSL for Prisma's query engine
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*

# Install dependencies (cached layer). The schema is needed for the
# postinstall `prisma generate`.
COPY package.json package-lock.json* .npmrc ./
COPY prisma ./prisma
RUN npm install --silent

# Copy everything (overridden by docker-compose volumes in dev)
COPY . .

ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1

EXPOSE 3000

# Apply migrations, regenerate the client (schema may be volume-mounted and
# newer than the image), then start the dev server on all interfaces.
CMD ["sh", "-c", "npx prisma migrate deploy && npx prisma generate && npm run dev -- -p 3000 -H 0.0.0.0"]
