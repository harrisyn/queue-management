### Database + Runtime
DATABASE_URL="postgresql://postgres:postgres@host.docker.internal:5432/qms_db"
REDIS_URL="redis://redis:6379"
JWT_SECRET="your-secret-key-change-in-production"
PORT=9000
NODE_ENV=development
FRONTEND_URL="http://localhost:8003"

### SMTP / Email (development)
# Point these at the Mailpit service in this repository when running with docker-compose
# Mailpit SMTP: mailpit:1025  — Web UI: http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="\"QMS\" <noreply@qms.local>"

### Production: override SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS with your provider's settings

### Payments
# 32+ character random string used to encrypt payment provider secret keys at rest.
# Generate with: openssl rand -hex 32
MASTER_ENCRYPTION_KEY=
